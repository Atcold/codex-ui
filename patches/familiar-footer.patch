+/// The macOS computer name matches the name used in the shell prompt. Cache the
+/// system query because status surfaces refresh frequently while streaming.
+fn status_line_machine_name() -> Option<&'static str> {
+    static NAME: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+    NAME.get_or_init(|| {
+        #[cfg(target_os = "macos")]
+        if let Ok(output) = std::process::Command::new("/usr/sbin/scutil")
+            .args(["--get", "ComputerName"])
+            .output()
+            && output.status.success()
+        {
+            let name = String::from_utf8_lossy(&output.stdout).trim().to_owned();
+            if !name.is_empty() {
+                return Some(name);
+            }
+        }
+        os_host_name()
+    })
+    .as_deref()
+}
+
+/// Each filled box represents ten percent of the consumed allowance.
+fn status_line_quota_bar(window: &RateLimitWindowDisplay, label: &str) -> String {
+    let used = window.used_percent.clamp(0.0, 100.0);
+    let filled = (used / 10.0).round() as usize;
+    let prefix = if label.is_empty() {
+        String::new()
+    } else {
+        format!("{label} ")
+    };
+    let mut text = format!(
+        "{prefix}{used:.0}% {}{}",
+        "◼".repeat(filled),
+        "◻".repeat(10 - filled),
+    );
+    if let Some(reset) = &window.resets_at {
+        let time = reset.split(" on ").next().unwrap_or(reset);
+        let time = chrono::NaiveTime::parse_from_str(time, "%H:%M")
+            .or_else(|_| chrono::NaiveTime::parse_from_str(time, "%I:%M %p"))
+            .map(|time| time.format("%-H:%M").to_string())
+            .unwrap_or_else(|_| time.to_owned());
+        text.push_str(&format!(" → {time}"));
+    }
+    text
+}
